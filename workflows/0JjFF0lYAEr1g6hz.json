      },
      "id": "g2",
      "name": "설정",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        112
      ],
      "notes": "백업 대상: https://github.com/070821love-a11y/claude_n8n"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('설정').first().json;\nreturn $input.all().map(i => {\n  const wf = { ...i.json };\n  // 민감할 수 있는 실행 시 데이터는 백업에서 제외\n  delete wf.staticData; delete wf.pinData; delete wf.shared;\n  const text = JSON.stringify(wf, null, 2) + '\\n';\n  return { json: {\n    path: `${cfg.folder}/${wf.id}.json`,\n    name: wf.name,\n    content: Buffer.from(text, 'utf8').toString('base64')\n  } };\n});"
      },
      "id": "g4",
      "name": "파일 생성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        112
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('설정').first().json.owner }}/{{ $('설정').first().json.repo }}/contents/{{ $json.path }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "ref",
              "value": "={{ $('설정').first().json.branch }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "User-Agent",
              "value": "n8n-backup"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "g5",
      "name": "GitHub 기존 파일 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        912,
        112
      ],
      "credentials": {
        "githubApi": {
          "id": "eBVkFpyweKY4ZBJT",
          "name": "GitHub account"
        }
      },
      "notes": "404(신규 파일/빈 저장소)는 정상 → neverError"
    },
    {
      "parameters": {
        "jsCode": "const files = $('파일 생성').all();\nconst out = [];\n$input.all().forEach((r, i) => {\n  const f = files[i].json;\n  const ex = r.json;\n  const exists = !!(ex && ex.sha && ex.content);\n  if (exists && String(ex.content).replace(/\\n/g, '') === f.content) return; // 변경 없음 → 스킵\n  // branch 미지정 = 기본 브랜치 (빈 저장소에서도 동작)\n  const body = {\n    message: `backup: ${f.name} (${new Date().toISOString().slice(0, 10)})`,\n    content: f.content\n  };\n  if (exists) body.sha = ex.sha;\n  out.push({ json: { path: f.path, body } });\n});\nreturn out;"
      },
