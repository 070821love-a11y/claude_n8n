    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nlet text = j.choices?.[0]?.message?.content ?? j.output?.[0]?.content?.[0]?.text ?? j.text ?? '';\ntext = String(text).replace(/```json|```/g, '').trim();\nconst d = JSON.parse(text);\nreturn [{ json: { title: d.title, description: d.description } }];"
      },
