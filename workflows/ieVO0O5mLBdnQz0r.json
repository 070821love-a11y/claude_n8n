    {
      "parameters": {
        "jsCode": "const b = $('블로그 내용 정리').first().json;\nconst img = $('이미지 URL 추출').first().json.imageUrl;\nconst esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst html = `<div style=\"font-family:'Malgun Gothic',sans-serif;max-width:640px;margin:auto;color:#333;line-height:1.7\">\n<h1 style=\"color:#d9480f\">🍚 ${esc(b.title)}</h1>\n<p style=\"background:#fff4e6;padding:12px;border-radius:8px\"><b>음식 설명:</b> ${esc(b.description)}</p>\n<img src=\"${img}\" alt=\"${esc(b.title)}\" style=\"width:100%;border-radius:8px\"/>\n<p>${esc(b.intro)}</p>\n<h2>🛒 재료</h2><ul>${(b.ingredients||[]).map(i=>`<li>${esc(i)}</li>`).join('')}</ul>\n<h2>👩‍🍳 요리 순서</h2><ol>${(b.steps||[]).map(s=>`<li>${esc(s)}</li>`).join('')}</ol>\n<h2>💡 요리 팁</h2><p>${esc(b.tip)}</p>\n<hr/><p style=\"color:#999;font-size:12px\">n8n 자동 발송 · ${new Date().toLocaleDateString('ko-KR')}</p>\n</div>`;\nreturn [{ json: { subject: `[오늘의 한식] ${b.title} 만드는 방법`, html }, binary: $input.first().binary }];"
      },
