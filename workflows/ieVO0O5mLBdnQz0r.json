    {
      "parameters": {
        "jsCode": "const pages = Object.values($input.first().json.query?.pages ?? {}).sort((a,b)=>(a.index??99)-(b.index??99));\nconst hit = pages.find(p => p.thumbnail?.source);\nreturn [{ json: { imageUrl: hit ? hit.thumbnail.source : 'https://upload.wikimedia.org/wikipedia/commons/thumb/7/7e/Korean_cuisine-Bibimbap-03.jpg/800px-Korean_cuisine-Bibimbap-03.jpg' } }];"
      },
