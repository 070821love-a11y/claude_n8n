    {
      "id": "w3",
      "name": "메시지 만들기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const names = ['서울시 역삼동', '서울시 구의동'];\nconst wmo = c => {\n  if (c === 0) return '맑음';\n  if (c <= 2) return '구름 조금';\n  if (c === 3) return '흐림';\n  if (c === 45 || c === 48) return '안개';\n  if (c >= 51 && c <= 57) return '이슬비';\n  if (c >= 61 && c <= 67) return '비';\n  if (c >= 71 && c <= 77) return '눈';\n  if (c >= 80 && c <= 82) return '소나기';\n  if (c === 85 || c === 86) return '눈 소나기';\n  if (c >= 95) return '뇌우';\n  return '알 수 없음';\n};\nlet data = $input.all().map(i => i.json);\nif (data.length === 1 && Array.isArray(data[0])) data = data[0];\nconst blocks = data.map((d, i) => {\n  const cur = d.current;\n  const pop = d.daily.precipitation_probability_max[0];\n  return `[${names[i]} 날씨]\\n- 날씨: ${wmo(cur.weather_code)}\\n- 온도: ${cur.temperature_2m}°C\\n- 습도: ${cur.relative_humidity_2m}%\\n- 강수확률: ${pop ?? '-'}%`;\n});\nreturn [{ json: { text: blocks.join('\\n\\n') } }];"
      }
    },
    {
